rules_version = '2';

// 수학도서관 1MM 보고서 · Firestore 권한 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣고 [게시]를 누르세요.
//
// - 관리자: 모든 학생·보고서에 대해 모든 권한
// - 선생님: 자기가 담임인 학생의 보고서만 작성·수정, 부담임으로 들어간 학생은 보기만
// - 첫 관리자(원장님 계정)는 staff 문서가 없어도 관리자로 인정합니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && myEmail() == 'ilmvm66@gmail.com';
    }
    function staffDoc() {
      return /databases/$(database)/documents/staff/$(myEmail());
    }
    function isStaff() {
      return isOwner() || (signedIn() && exists(staffDoc()) && get(staffDoc()).data.active == true);
    }
    function isAdmin() {
      return isOwner() || (isStaff() && get(staffDoc()).data.role == 'admin');
    }
    function studentOf(id) {
      return get(/databases/$(database)/documents/students/$(id)).data;
    }

    // 선생님 명단 — 로그인한 선생님은 이름 표시용으로 읽을 수 있고, 바꾸는 것은 관리자만
    match /staff/{email} {
      allow read: if isStaff() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    // 학원 공통 설정 (AI 인식 주소 등)
    match /config/{doc} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // 학생 — 담임·부담임 선생님은 읽기, 등록·배정은 관리자
    match /students/{id} {
      allow read: if isAdmin()
        || (isStaff() && (resource.data.homeroom == myEmail() || resource.data.sub == myEmail()));
      allow write: if isAdmin();
    }

    // 보고서
    match /reports/{id} {
      allow read: if isAdmin()
        || (isStaff() && (resource.data.homeroom == myEmail() || resource.data.sub == myEmail()));

      // 선생님은 자기 담임 학생의 보고서만 새로 만들 수 있음
      allow create: if isAdmin()
        || (isStaff()
            && request.resource.data.homeroom == myEmail()
            && studentOf(request.resource.data.studentId).homeroom == myEmail()
            && request.resource.data.status in ['draft', 'done']);

      // 선생님은 작성 중인 자기 담임 보고서만 고치고 '완료'로 바꿀 수 있음
      // (완료된 보고서를 다시 여는 것, 상담 끝 표시는 관리자)
      allow update: if isAdmin()
        || (isStaff()
            && resource.data.homeroom == myEmail()
            && resource.data.status == 'draft'
            && request.resource.data.homeroom == myEmail()
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.status in ['draft', 'done']);

      allow delete: if isAdmin();
    }
  }
}
